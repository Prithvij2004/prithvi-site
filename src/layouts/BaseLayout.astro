---
import Sidebar from "../components/Sidebar.astro";
import "../styles/editorial.css";

const {
  title = "Prithvi J - Editorial",
  description = "Prithvi Jayakumar is an AI and software engineer building practical systems with LLMs, automation, data, and full-stack software.",
  active = "home",
  bodyClass = "",
  showRose = false,
  includeRoseScript = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    <div class="page">
      <Sidebar active={active} showRose={showRose} />
      <main class="content">
        <slot />
      </main>
    </div>
    {includeRoseScript && <script is:inline src="/rose-pattern.js"></script>}
  </body>
</html>
