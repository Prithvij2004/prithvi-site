---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkEntries from "../components/WorkEntries.astro";
---

<BaseLayout
  title="Prithvi Jayakumar"
  active="home"
  bodyClass="home-only"
>
  <div class="hero">
    <div>
      <h1 class="hero-name">Prithvi Jayakumar</h1>
      <p class="lead serif">
        I'm an engineer who likes to solve hard problems. I currently work with/on AI.
        In the meantime I also like to read books, hear music and mainly build
        <a href="/projects" class="external-link">side projects</a>. To know more about me, explore the page.
      </p>
      <p class="lead serif">
        You can read my essays at
        <a href="/blog" class="external-link" target="_blank" rel="noopener noreferrer">Blog</a>.
        I hardly post on socials but you can contact me at
        <a href="https://x.com/prithvii_J" class="external-link" target="_blank" rel="noopener noreferrer">X</a>
        and
        <a href="https://www.linkedin.com/in/prithvij2004" class="external-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
        Also yes, email me at
        <a href="mailto:prithvijayakumardev@gmail.com" class="external-link">prithvijayakumardev@gmail.com</a>.
      </p>
    </div>
  </div>

  <section class="section home-experience">
    <div class="section-body">
      <h2>Experience</h2>
      <WorkEntries />
    </div>
  </section>
</BaseLayout>
