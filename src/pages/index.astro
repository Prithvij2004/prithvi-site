        <a href="mailto:prithvijayakumardev@gmail.com">email me</a>
        <a href="https://www.linkedin.com/in/prithvij2004" target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href="https://github.com/Prithvij2004" target="_blank" rel="noopener noreferrer">github</a>
        <a href="/Resume_Final_March_2026.pdf" target="_blank" rel="noopener noreferrer">resume</a>
      </div>
    </div>
