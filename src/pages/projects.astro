---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects - Prithvi Jayakumar" active="projects">
  <section class="section projects-section">
    <div class="section-body">
      <h1>Projects</h1>
      <div class="project-list">
        <article class="project">
          <div class="project-title">
            <h3>InnerScript</h3>
            <span class="meta">Personal AI writing tool</span>
          </div>
          <div class="entry-content">
            <p>A journal writing app that uses AI to extract mood, characters, and ideologies from journal entries.</p>
          </div>
        </article>

        <article class="project">
          <div class="project-title">
            <h3>Bitsit</h3>
            <span class="meta">Marketplace product</span>
          </div>
          <div class="entry-content">
            <p>A coupon reselling marketplace with search, sorting, and an escrow account flow for seller funds.</p>
          </div>
        </article>

        <article class="project">
          <div class="project-title">
            <h3>Spider Rose</h3>
            <span class="meta">Local agent workflow builder</span>
          </div>
          <div class="entry-content">
            <p>A local tool for developers and AI builders to compose block-based agents through a TUI and visual web canvas, configured with Markdown or LangGraph code.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
