---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects - Prithvi J" active="projects">
  <section class="section">
    <div class="section-label">Projects</div>
    <div class="section-body">
      <h1>Selected projects, written around the problem and result.</h1>
      <div class="project-list">
        <article class="project">
          <div class="project-title">
            <h3>PDF to Excel Extraction System</h3>
            <span class="meta">Document AI · active development</span>
          </div>
          <div class="entry-content">
            <p>
              Built an AI-assisted pipeline to extract structured fields from messy 25+ page
              government forms into a strict Excel taxonomy. Worked on layout-aware extraction,
              prompt design, validation, web UI, and workflow reliability.
            </p>
            <div class="tags">
              <span class="tag">Python</span>
              <span class="tag">LLMs</span>
              <span class="tag">Excel</span>
              <span class="tag">Document AI</span>
            </div>
          </div>
        </article>

        <article class="project">
          <div class="project-title">
            <h3>Customer Feedback Dashboard</h3>
            <span class="meta">Production AI dashboard</span>
          </div>
          <div class="entry-content">
            <p>
              Built a dashboard that ingests feedback sheets, creates structured insights, and
              lets executives query historical feedback through an agentic RAG chat interface.
            </p>
            <div class="tags">
              <span class="tag">React</span>
              <span class="tag">MySQL</span>
              <span class="tag">Bedrock</span>
              <span class="tag">AWS EC2</span>
            </div>
          </div>
        </article>

        <article class="project">
          <div class="project-title">
            <h3>InnerScript</h3>
            <span class="meta">Personal AI writing tool</span>
          </div>
          <div class="entry-content">
            <p>A journal writing app that uses AI to extract mood, characters, and ideologies from journal entries.</p>
            <div class="tags">
              <span class="tag">Next.js</span>
              <span class="tag">JavaScript</span>
              <span class="tag">TanStack Query</span>
            </div>
          </div>
        </article>

        <article class="project">
          <div class="project-title">
            <h3>Bitsit</h3>
            <span class="meta">Marketplace product</span>
          </div>
          <div class="entry-content">
            <p>A coupon reselling marketplace with search, sorting, and an escrow account flow for seller funds.</p>
            <div class="tags">
              <span class="tag">Next.js</span>
              <span class="tag">Railway</span>
              <span class="tag">Marketplace</span>
            </div>
          </div>
        </article>

        <article class="project">
          <div class="project-title">
            <h3>Job Finder</h3>
            <span class="meta">Automation system</span>
          </div>
          <div class="entry-content">
            <p>
              Uses Claude Code to find jobs from selected companies, match them against my CV,
              and generate tailored resumes through scheduled workflows.
            </p>
            <div class="tags">
              <span class="tag">Automation</span>
              <span class="tag">Claude Code</span>
              <span class="tag">Resumes</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
